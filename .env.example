# Optional. Enables AI-assisted resume parsing and roadmap generation via
# @anthropic-ai/sdk. This key is only ever read server-side (in app/api/*
# route handlers) and is never exposed to the browser.
#
# Without it, the app falls back to a heuristic resume parser and a
# rich pre-written roadmap template — everything still works.
ANTHROPIC_API_KEY=

# ---- Database & Auth (Supabase) ----
# Required for persistence and authentication. Without these, the app still
# builds and runs, but every page that needs a signed-in profile (Accelerate,
# SkillForge, Dashboard, Saved, Profile, Onboarding) shows a "sign in" /
# "not configured" state instead of real data — see docs/database.md for how
# to create a free Supabase project and run the migrations.

# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > service_role key. SERVER-ONLY — never prefix this
# with NEXT_PUBLIC_. Used only for account deletion and reference-data/demo
# seeding (lib/supabase/admin.ts). Without it, account deletion is disabled
# and the seed scripts can't run.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by Drizzle (lib/db/client.ts) and
# the migration/seed scripts. In Supabase: Project Settings > Database >
# Connection string (use the "Transaction" pooler connection for serverless
# deployments, e.g. Vercel; the direct connection is fine for local scripts).
DATABASE_URL=

# ---- GitHub integration ----
# Both optional. Public username/repo analysis (lib/github/analyze-repo.ts)
# works with neither set — unauthenticated GitHub API calls are just capped
# at 60 requests/hour per IP instead of 5,000/hour. See docs/github-integration.md.

# A GitHub personal access token used for EVERY server-side GitHub API call
# that isn't already using a connected student's own token — raises the
# app-wide rate limit. No scopes needed (only public data is ever read).
GITHUB_TOKEN=

# Base64-encoded 32-byte key (e.g. `openssl rand -base64 32`) used to
# AES-256-GCM-encrypt a connected student's GitHub OAuth token at rest
# (github_connections.access_token_encrypted — see lib/github/token-crypto.ts).
# Without it, "Connect GitHub" still links the identity via Supabase but the
# resulting token simply isn't persisted — public analysis is unaffected.
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---- Demo mode ----
# Optional. When both are set, a "Try Demo" button signs visitors straight
# into a shared, clearly-labeled showcase account with realistic seeded data
# — no signup required. Seed (or refresh) that account with:
#   npm run db:seed:reference   # careers + SkillForge modules (run first)
#   npm run db:seed:demo        # the demo profile, roadmap, matches, progress
# Requires SUPABASE_SERVICE_ROLE_KEY above (to create the demo auth user).
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
